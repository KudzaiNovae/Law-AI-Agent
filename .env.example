# Copy to .env and fill in. Empty values disable that feature.

# --- LLM providers (at least one required) ---
PROVIDER=gemini                 # "gemini" or "anthropic" — tried first
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash,gemini-flash-latest,gemini-2.0-flash
ANTHROPIC_API_KEY=sk-ant-...
MODEL=claude-haiku-4-5
# Local Ollama as last-resort fallback (empty = disabled)
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1/

# --- Admin portal ---
ADMIN_TOKEN=

# --- Payments (Paynow) ---
PAYNOW_ID=
PAYNOW_KEY=

# --- Password-reset email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Importers / scrapers ---
LAWSAFRICA_TOKEN=

# --- Abuse guards (optional overrides) ---
# RATE_LIMIT=30
# ANON_IP_DAILY=25
# SIGNUP_IP_DAILY=10
